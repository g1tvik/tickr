# ============================================================================
# tickr — Frontend environment configuration (Vite)
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#   cp .env.example .env
#
# IMPORTANT: Vite only exposes variables prefixed with VITE_ to the browser.
# (Create-React-App style REACT_APP_* variables are IGNORED — do not use them.)
# Never put secrets here; everything in this file ships to the browser.
# ============================================================================

# Base URL of the backend API, including the /api suffix.
# In local dev, Vite proxies /api to the backend, so the default is fine.
VITE_API_BASE_URL=http://localhost:5001/api

# Google OAuth client ID (must match GOOGLE_CLIENT_ID in the backend .env).
# Leave blank to hide the "Sign in with Google" button gracefully.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Lockdown / waitlist mode. When "true", every route redirects to /waitlist.
VITE_LOCKDOWN=false

# Canonical public site URL, used for SEO/Open Graph tags.
VITE_SITE_URL=https://tickr.app
