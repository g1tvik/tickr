# ============================================================================
# tickr — Backend environment configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#   cp .env.example .env
# The server validates these at boot (see middleware/validateEnv.js) and will
# refuse to start if a REQUIRED variable is missing or invalid.
# ============================================================================

# ---- REQUIRED -------------------------------------------------------------

# Secret used to sign JWTs. MUST be a long random string (min 16 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-16-chars

# Google OAuth client ID (from https://console.cloud.google.com → Credentials).
# Must match VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Alpaca API credentials (https://alpaca.markets). Used for market data + paper trading.
# If you don't have these yet, the app runs in DEMO mode with sample market data.
ALPACA_API_KEY=your-alpaca-key
ALPACA_SECRET_KEY=your-alpaca-secret

# ---- DATABASE (Postgres) --------------------------------------------------

# Postgres connection string. Required in production.
# Local docker-compose default:
DATABASE_URL=postgres://tickr:tickr@localhost:5432/tickr
# When running via docker-compose the host is the service name, e.g.:
#   DATABASE_URL=postgres://tickr:tickr@db:5432/tickr
# Set to "true" if your managed Postgres requires SSL (most cloud providers do):
DATABASE_SSL=false

# ---- OPTIONAL (sensible defaults applied if omitted) ----------------------

# Port the API listens on.
PORT=5001

# development | production | test
NODE_ENV=development

# Public URL of the frontend (used for CORS allow-list + email links).
FRONTEND_URL=http://localhost:5173

# Lockdown / waitlist mode: when "true", only approved users can use the app.
LOCKDOWN=false

# Admin API key — guards the waitlist export + invite-creation endpoints.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# If unset, those admin endpoints are DISABLED (fail-closed). Send as header x-admin-key.
ADMIN_API_KEY=

# Extra CORS origins (comma-separated), in addition to FRONTEND_URL. Optional.
# CORS_EXTRA_ORIGINS=https://www.yourdomain.com

# Set CONFIRM_LIVE_TRADING=true ONLY if you intentionally run ALPACA_ENV=live (real money).
CONFIRM_LIVE_TRADING=false

# Alpaca trading environment: "paper" (sandbox, fake money) or "live" (REAL money).
# Keep this on "paper" unless you really know what you're doing.
ALPACA_ENV=paper

# ---- EMAIL (optional — falls back to a test inbox if omitted) --------------
# Used for waitlist confirmations, goal reminders, invites.
EMAIL_SERVICE=gmail
EMAIL_USER=service-account@example.com
EMAIL_PASSWORD=app-specific-password

# ---- GOOGLE OAUTH (optional) ----------------------------------------------
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---- GEMINI AI COACH (optional — falls back to built-in coaching if omitted)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ---- PATHS (optional — only override if you know you need to) --------------
# DATA_DIR=./data
# AUTH_LOG_DIR=../logs
